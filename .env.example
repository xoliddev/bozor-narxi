# Copy this file to .env and fill in your own values. Never commit .env.

# Token from @BotFather (looks like 123456789:AA...). The placeholder below is NOT a real token.
BOT_TOKEN=123456789:replace-with-your-token-from-BotFather

# Public HTTPS address of this server, without a trailing slash (for example a free cloudflared tunnel).
# The website opens at https://<address>/ and the Mini App at https://<address>/webapp/.
# Leave empty to run the bot only (the website still runs on HOST:PORT, but the bot will not link to it).
PUBLIC_URL=

# Telegram user ids of the moderators (comma separated; find yours with @userinfobot).
# They get shubhali reports in the bot and can hide reports and ban reporters.
MODERATOR_IDS=

# Where the SQLite file lives (the folder is created automatically).
DB_PATH=data/bozornarxi.db
# Fill an empty database with the invented city (90 days of reports at Tashkent bazaars). 0 = start empty.
# Seeded people have negative ids, so nobody can sign in as them.
SEED_DEMO=1

# Web server for the website, the Mini App and their APIs.
HOST=0.0.0.0
PORT=8080

# Mini App login data older than this many seconds is refused.
INITDATA_MAX_AGE=3600
# Per minute: bot buttons per user, Mini App calls per user, public website API calls per address.
RATE_PER_MINUTE=30
API_RATE_PER_MINUTE=120
PUBLIC_RATE_PER_MINUTE=120
# Set to 1 only behind a reverse proxy you control (then X-Forwarded-For is trusted for the per-address limit).
TRUST_PROXY=0
LOG_LEVEL=INFO
